# Runtime
NODE_ENV=development
LOG_LEVEL=debug
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000

# Supabase public values
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Server-only Supabase values
SUPABASE_URL=http://supabase-kong:8000
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
SUPABASE_JWT_ISSUER=http://localhost:54321/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
ALLOWED_EMAIL_DOMAIN=thapar.edu

# PostgreSQL
DATABASE_PRIMARY_URL=postgresql://app:local-password@postgres-primary:5432/tiet_social
DATABASE_REPLICA_URL=postgresql://app_readonly:local-password@postgres-replica:5432/tiet_social
REPLICA_MAX_LAG_SECONDS=5

# Kafka
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=tiet-social
KAFKA_CONSUMER_GROUP_PREFIX=tiet-social-local
KAFKA_TOPIC_PREFIX=tiet-social.local

# Valkey
VALKEY_URL=redis://valkey:6379
VALKEY_KEY_PREFIX=tiet-social:local

# Storage and media
STORAGE_QUARANTINE_BUCKET=media-quarantine
STORAGE_PUBLISHED_BUCKET=media-published
UPLOAD_TOKEN_TTL_SECONDS=900
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Local moderation
MODERATION_PROVIDER=local
MODERATION_SERVICE_URL=http://moderation:8080
MODERATION_POLICY_VERSION=moderation-policy-v1
MODERATION_ALLOW_THRESHOLD=0.35
MODERATION_REJECT_THRESHOLD=0.85

# Observability
OTEL_SERVICE_NAME=tiet-social-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
PROMETHEUS_METRICS_TOKEN=replace-with-local-token

# Feature kill switches
FEATURE_MESSAGING_ENABLED=false
FEATURE_STORIES_ENABLED=false
FEATURE_MEDIA_UPLOAD_ENABLED=true
