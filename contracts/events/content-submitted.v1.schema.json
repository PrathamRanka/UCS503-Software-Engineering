{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiet-social.local/schemas/content-submitted.v1.schema.json",
  "title": "content.submitted.v1 payload",
  "type": "object",
  "required": ["contentId", "authorId", "contentType", "visibility", "mediaAssetIds", "moderationPolicyVersion"],
  "properties": {
    "contentId": { "type": "string", "format": "uuid" },
    "authorId": { "type": "string", "format": "uuid" },
    "contentType": { "enum": ["post", "reel", "story", "message"] },
    "visibility": { "enum": ["campus", "followers", "community", "conversation"] },
    "communityId": { "type": ["string", "null"], "format": "uuid" },
    "caption": { "type": ["string", "null"], "maxLength": 2200 },
    "mediaAssetIds": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" },
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true
    },
    "moderationPolicyVersion": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
