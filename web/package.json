{
  "name": "@titalks/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:unit": "vitest run src/utils src/components/ui",
    "test:integration": "vitest run src/components/auth",
    "test:smoke": "node scripts/smoke-ui.mjs",
    "test:staging": "node scripts/staging-check.mjs",
    "test:all": "npm run test && npm run build && npm run test:smoke && npm run test:staging",
    "test:ui": "node scripts/smoke-ui.mjs",
    "preview": "vite preview",
    "images:webp": "node scripts/convert-images.mjs"
  },
  "dependencies": {
    "lenis": "^1.3.26",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-infinite-scroll-hook": "^2.1.4",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.0.1",
    "playwright-core": "^1.63.0",
    "sharp": "^0.34.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.0.0"
  }
}
